{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.html",
    "libs/**/*.ts",
    "libs/**/*.html"
  ],
  "exclude": ["node_modules", "dist", "tmp", "**/*.spec.ts", "**/*.test.ts"]
}
