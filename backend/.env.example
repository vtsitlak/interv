GEMINI_API_KEY=your-api-key-here

# Interview chat (streaming) — fast model
GEMINI_CHAT_MODEL=gemini-3-flash-preview

# Profile training (skills extraction, personal Q&A prompts)
GEMINI_PROFILE_MODEL=gemini-3.1-pro-preview

# Optional legacy fallback for chat if GEMINI_CHAT_MODEL is unset
# GEMINI_MODEL=gemini-3-flash-preview

# Security — NEVER set in production
# DISABLE_FIREBASE_AUTH=true

# Input limits
INGEST_MAX_CV_CHARS=50000
CHAT_MAX_MESSAGE_CHARS=4000
PROFILE_MAX_SUMMARY_CHARS=1000
INGEST_MAX_LINK_URL_CHARS=100
INGEST_MAX_LINK_DESC_CHARS=500
INGEST_MAX_QA_PAIRS=30
INGEST_MAX_LINKS=15

# Per-profile quotas (Firestore-backed)
INGEST_COOLDOWN_SEC=600
PERSONAL_QA_MAX_PER_HOUR=20
SUGGESTED_QUESTIONS_MAX_PER_HOUR=60
SUMMARIZE_MAX_PER_HOUR=30

FIREBASE_SERVICE_ACCOUNT_KEY=

# Comma-separated extra CORS origins
# BACKEND_CORS_ORIGINS=https://your-app.example
