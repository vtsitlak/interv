rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function profileDoc(profileId) {
      return get(/databases/$(database)/documents/profiles/$(profileId));
    }

    function profileIsPublished(profileId) {
      return profileDoc(profileId).data.get('isPublished', false) == true;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /recruiters/{recruiterId} {
      allow read, write: if request.auth != null && request.auth.uid == recruiterId;

      match /interviews/{interviewId} {
        allow read, write: if request.auth != null && request.auth.uid == recruiterId;
      }
    }

    match /profiles/{profileId} {
      allow read: if request.auth != null && request.auth.uid == profileId
        || (resource != null && resource.data.get('isPublished', false) == true);

      allow create: if request.auth != null && request.auth.uid == profileId;

      allow update, delete: if request.auth != null && request.auth.uid == profileId;

      match /interviews/{interviewId} {
        allow read: if request.auth != null && request.auth.uid == profileId
          || profileIsPublished(profileId)
          || (request.auth != null
            && resource != null
            && resource.data.get('recruiterUid', '') == request.auth.uid);

        allow create: if profileIsPublished(profileId)
          && request.resource.data.profileId == profileId
          && request.resource.data.status == 'in_progress'
          && (
            !('recruiterUid' in request.resource.data)
            || request.resource.data.recruiterUid == null
            || request.resource.data.recruiterUid == request.auth.uid
          );

        allow update: if profileIsPublished(profileId)
          || (request.auth != null
            && resource != null
            && resource.data.get('recruiterUid', '') == request.auth.uid);

        allow delete: if request.auth != null && request.auth.uid == profileId;
      }
    }

    /**
     * Collection-group queries on `interviews` (recruiter dashboard fallback).
     */
    match /{path=**}/interviews/{interviewId} {
      allow read: if request.auth != null
        && resource != null
        && resource.data.get('recruiterUid', '') == request.auth.uid;
    }
  }
}
