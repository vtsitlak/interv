# E2E credentials (copy to e2e/.env — never commit .env)
# Create dedicated Firebase Auth users for automation (not production accounts).

E2E_CANDIDATE_EMAIL=your-candidate-e2e@example.com
E2E_CANDIDATE_PASSWORD=your-candidate-password

# Must be created via /recruiter/register (recruiter role), not /register.
E2E_RECRUITER_EMAIL=your-recruiter-e2e@example.com
E2E_RECRUITER_PASSWORD=your-recruiter-password

# Optional: point at a deployed app instead of local nx serve
# BASE_URL=https://getinterv.web.app
