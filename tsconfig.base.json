{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@interv/shared": ["./libs/shared/src/index.ts"],
      "@interv/feature-auth": ["./libs/auth/src/index.ts"],
      "@interv/account": ["./libs/account/src/index.ts"],
      "@interv/home": ["./libs/home/src/index.ts"],
      "@interv/candidate-profile": [
        "./libs/candidate-profile/src/lib/profile/profile.ts"
      ],
      "@interv/candidate-profile/train": [
        "./libs/candidate-profile/src/lib/profile-train/profile-train.ts"
      ],
      "@interv/candidate-dashboard": [
        "./libs/candidate-dashboard/src/index.ts"
      ],
      "@interv/interview": ["./libs/interview/src/index.ts"],
      "@interv/recruiter-feedback": ["./libs/recruiter-feedback/src/index.ts"],
      "@interv/state-auth": ["./libs/states/auth/src/index.ts"],
      "@interv/state-profile": ["./libs/states/profile/src/index.ts"],
      "@interv/state-interview": ["./libs/states/interview/src/index.ts"],
      "@interv/state-dashboard": ["./libs/states/dashboard/src/index.ts"],
      "@interv/state-recruiter": ["./libs/states/recruiter/src/index.ts"],
      "@interv/recruiter": ["./libs/recruiter/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
