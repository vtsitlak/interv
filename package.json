{
  "name": "@interv/source",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "start": "nx serve",
    "start:backend": "cd backend && venv\\Scripts\\uvicorn main:app --reload --host 127.0.0.1 --port 8000",
    "start:all": "concurrently -n app,api -c blue,magenta --kill-others-on-fail \"npm:start\" \"npm:start:backend\"",
    "build": "nx build",
    "test": "nx test",
    "e2e": "nx e2e e2e",
    "e2e:local": "playwright test --config e2e/playwright.config.ts",
    "e2e:ui": "nx e2e e2e -- --ui",
    "e2e:install-browsers": "playwright install",
    "build:interv:prod": "nx run interv:build --configuration=production",
    "deploy:firebase": "firebase deploy --only hosting,firestore:rules",
    "deploy:firebase:ci": "firebase deploy --only hosting,firestore:rules --non-interactive",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules",
    "deploy:storage:rules": "firebase deploy --only storage",
    "release:hosting": "npm run build:interv:prod && npm run deploy:firebase"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.0.7",
    "@angular/compiler": "22.0.7",
    "@angular/core": "22.0.7",
    "@angular/fire": "^21.0.0-rc.0",
    "@angular/forms": "22.0.7",
    "@angular/platform-browser": "22.0.7",
    "@angular/platform-browser-dynamic": "22.0.7",
    "@angular/router": "22.0.7",
    "@ngrx/signals": "^21.1.0",
    "firebase": "^11.10.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular-devkit/core": "22.0.7",
    "@angular-devkit/schematics": "22.0.7",
    "@angular/build": "22.0.7",
    "@angular/cli": "22.0.7",
    "@angular/compiler-cli": "22.0.7",
    "@angular/language-service": "22.0.7",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.1.0",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/playwright": "23.1.0",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@oxc-project/runtime": "^0.115.0",
    "@playwright/test": "^1.36.0",
    "@schematics/angular": "22.0.7",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "22.1.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.2",
    "daisyui": "^5.5.19",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^1.6.2",
    "firebase-tools": "^14.0.0",
    "jest": "30.3.0",
    "jest-environment-jsdom": "^30.0.2",
    "jest-preset-angular": "17.0.0",
    "jest-util": "^30.0.2",
    "jsdom": "^27.1.0",
    "nx": "23.1.0",
    "postcss": "^8.5.14",
    "prettier": "~3.6.2",
    "tailwindcss": "^4.2.4",
    "ts-jest": "^29.4.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "nx": {
    "includedScripts": []
  },
  "overrides": {
    "@angular/fire": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic"
    },
    "@ngrx/signals": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core"
    }
  }
}
